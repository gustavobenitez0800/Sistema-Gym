{
  "name": "ayd-funcional-gym",
  "version": "1.0.7",
  "description": "Sistema de Gestion AyD Funcional Gym 2026",
  "repository": {
    "type": "git",
    "url": "https://github.com/gustavobenitez0800/Sistema-Gym.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "web": "npx serve -l 3000",
    "build": "electron-builder -w"
  },
  "keywords": [
    "gym",
    "management",
    "electron"
  ],
  "author": "AyD",
  "license": "ISC",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3",
    "serve": "^14.2.4"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.7.3"
  },
  "build": {
    "appId": "com.aydfuncional.gym",
    "productName": "AyD Funcional Gym",
    "publish": [
      {
        "provider": "github",
        "owner": "gustavobenitez0800",
        "repo": "Sistema-Gym"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "asar": false,
    "directories": {
      "output": "dist"
    }
  }
}